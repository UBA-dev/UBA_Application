                </div>
                {messageError && (
                  <p className="text-xs" style={{ color: "#f87171" }}>{messageError}</p>
                )}
                {draftedMessage && (
                  <div className="mt-2">
                    <textarea
                      value={draftedMessage}
                      onChange={(e) => setDraftedMessage(e.target.value)}
