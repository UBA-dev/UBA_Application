                      >
                        <p className="text-sm font-medium" style={{ color: "var(--color-text-primary)" }}>{item.name}</p>
                        <p className="text-xs" style={{ color: "var(--color-text-secondary)" }}>Stock: {item.stock} {item.unit || "Piece"}</p>
                      </button>
