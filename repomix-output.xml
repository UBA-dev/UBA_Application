                    <input
                      value={editPoNumber}
                      onChange={(e) => setEditPoNumber(e.target.value.replace(/[^0-9-]/g, ""))}
                      inputMode="numeric"
                      className="w-full mt-1 px-2 py-1.5 text-xs"
